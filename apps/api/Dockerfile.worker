# Воркер сканирования: тот же код, что и API, плюс все сканеры.
# Контекст сборки — корень репозитория: docker build -f apps/api/Dockerfile.worker .
FROM node:22-bookworm-slim AS base
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

FROM base AS build
RUN pnpm install --frozen-lockfile --filter @qorgan/api
COPY apps/api apps/api
RUN pnpm --filter @qorgan/api build

FROM base AS deps
RUN pnpm install --frozen-lockfile --prod --filter @qorgan/api

FROM node:22-bookworm-slim AS tools
ARG TARGETARCH
ARG GITLEAKS_VERSION=8.30.1
ARG OSV_VERSION=2.7.0
ARG TRIVY_VERSION=0.76.1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar && rm -rf /var/lib/apt/lists/*
WORKDIR /tools
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) GL=x64; OSV=amd64; TV=64bit ;; \
      arm64) GL=arm64; OSV=arm64; TV=ARM64 ;; \
      *) echo "unsupported arch $TARGETARCH"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL}.tar.gz" | tar -xz gitleaks; \
    curl -fsSL -o osv-scanner "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_${OSV}"; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${TV}.tar.gz" | tar -xz trivy; \
    chmod +x gitleaks osv-scanner trivy

FROM node:22-bookworm-slim AS worker
ARG SEMGREP_VERSION=1.183.0
ARG CHECKOV_VERSION=3.4.3
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/py \
    && /opt/py/bin/pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" "checkov==${CHECKOV_VERSION}"
ENV PATH="/opt/py/bin:${PATH}" \
    NODE_ENV=production \
    TRIVY_CACHE_DIR=/cache/trivy \
    SEMGREP_SEND_METRICS=off
COPY --from=tools /tools/ /usr/local/bin/
WORKDIR /repo/apps/api
COPY --from=deps /repo/node_modules /repo/node_modules
COPY --from=deps /repo/apps/api/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY apps/api/package.json ./
RUN mkdir -p /cache/trivy && chown -R node:node /cache
# Сканеры не исполняют код репозитория, но всё равно работаем не от root.
USER node
CMD ["node", "dist/worker.js"]
