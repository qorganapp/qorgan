# Настройки для `docker compose up` из корня репозитория.
# Минимум для запуска: JWT_ACCESS_SECRET и JWT_REFRESH_SECRET.
# Для реальных сканов нужен GitHub App (GITHUB_*), для агента — ANTHROPIC_API_KEY
# (или LLM_PROVIDER=none, чтобы выключить агента).

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# В Docker Compose DB_HOST и REDIS_URL подставляются автоматически.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qorgan

# Случайные строки; `make env` сгенерирует их сам (или: openssl rand -hex 32).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
FRONTEND_URL=http://localhost:8080

REDIS_URL=redis://localhost:6379

# GitHub App (Settings → Developer settings → GitHub Apps)
# Permissions: Contents: read & write, Pull requests: read & write, Metadata: read.
# Events: Push, Pull request, Installation, Installation repositories.
# Webhook URL: <API>/api/github/webhook, Setup URL: <API>/api/github/setup, включить «Request user authorization (OAuth) during installation».
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Worker
WORKER_CONCURRENCY=2
SCAN_TIMEOUT_MS=900000
SEMGREP_CONFIGS=p/default
# Проверять ли найденные ключи запросом к провайдеру (GitHub/GitLab/Slack/Stripe)
SECRET_VALIDATION_ENABLED=false

# AI security agent (triage, fix PRs, PR review, chat). LLM_PROVIDER=none disables it.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
ANTHROPIC_API_KEY=
AGENT_MAX_STEPS=40
AGENT_TRIAGE_BATCH=20
AGENT_DAILY_TOKEN_BUDGET=3000000
AGENT_CONCURRENCY=1
# How many repository clones the agent keeps cached (space chat and relationship map)
AGENT_REPO_CACHE_MAX=8
