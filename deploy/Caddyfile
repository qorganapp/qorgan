{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Файлы с хешем в имени не меняются — кешируем надолго.
	@hashed path_regexp \-[A-Z0-9]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# index.html всегда свежий, чтобы новый деплой подхватывался сразу.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# SPA: неизвестные пути отдают index.html — роутинг делает Angular.
	try_files {path} /index.html
	file_server
}
